exports[`terminal card > matches the dark snapshot 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="860" height="280" viewBox="0 0 860 280" role="img" aria-labelledby="cardTitle" fill="none"><title id="cardTitle">Terminal transcript: whoami and principles for Gerard Loriz</title><style>text{font-family:'JetBrains Mono','SFMono-Regular',ui-monospace,Menlo,Consolas,monospace;dominant-baseline:auto}.t0{transform:translateX(66.8px);animation:type-t0 0.25s steps(8) 0.35s backwards}@keyframes type-t0{from{transform:translateX(0)}}.t1{transform:translateX(431.3px);animation:type-t1 1.48s steps(53) 0.68s backwards}@keyframes type-t1{from{transform:translateX(0)}}.t2{transform:translateX(107.3px);animation:type-t2 0.36s steps(13) 2.24s backwards}@keyframes type-t2{from{transform:translateX(0)}}.t3{transform:translateX(164px);animation:type-t3 0.56s steps(20) 3.06s backwards}@keyframes type-t3{from{transform:translateX(0)}}.t4{transform:translateX(131.6px);animation:type-t4 0.45s steps(16) 3.7s backwards}@keyframes type-t4{from{transform:translateX(0)}}.t5{transform:translateX(188.3px);animation:type-t5 0.64s steps(23) 4.23s backwards}@keyframes type-t5{from{transform:translateX(0)}}.t6{transform:translateX(253.1px);animation:type-t6 0.87s steps(31) 4.95s backwards}@keyframes type-t6{from{transform:translateX(0)}}.cursor{animation:blink 1.1s steps(1) 5.9s infinite}@keyframes blink{0%,50%{opacity:1}50.01%,100%{opacity:0}}@media (prefers-reduced-motion:reduce){.t0,.t1,.t2,.t3,.t4,.t5,.t6,.cursor{animation:none}}</style><defs><clipPath id="panelClip"><rect x="16" y="44" width="828" height="220" rx="8" fill="none" /></clipPath></defs><rect x="0.5" y="0.5" width="859" height="279" rx="12" fill="#0D0A14" stroke="#2A2140" stroke-width="1" /><circle cx="28" cy="26" r="5" fill="#FF5F57" opacity="0.9" /><circle cx="46" cy="26" r="5" fill="#FEBC2E" opacity="0.9" /><circle cx="64" cy="26" r="5" fill="#28C840" opacity="0.9" /><text x="430" y="30" fill="#A99FC0" font-size="12" font-weight="400" text-anchor="middle">gerard@profile: ~</text><rect x="16" y="44" width="828" height="220" rx="8" fill="#151022" /><text x="36" y="72" fill="#63C69A" font-size="13.5" font-weight="700" text-anchor="start">❯</text><text x="52.2" y="72" fill="#EDE8F7" font-size="13.5" font-weight="600" text-anchor="start">whoami</text><text x="36" y="96" fill="#A99FC0" font-size="13.5" font-weight="400" text-anchor="start">Gerard Loriz — Backend Developer · Cybersecurity · AI</text><text x="36" y="120" fill="#A99FC0" font-size="13.5" font-weight="400" text-anchor="start">Barcelona, ES</text><text x="36" y="144" fill="#63C69A" font-size="13.5" font-weight="700" text-anchor="start">❯</text><text x="52.2" y="144" fill="#EDE8F7" font-size="13.5" font-weight="600" text-anchor="start">cat principles.txt</text><text x="36" y="168" fill="#A99FC0" font-size="13.5" font-weight="400" text-anchor="start">secure by design</text><text x="36" y="192" fill="#A99FC0" font-size="13.5" font-weight="400" text-anchor="start">ship · measure · harden</text><text x="36" y="216" fill="#A99FC0" font-size="13.5" font-weight="400" text-anchor="start">build it — then try to break it</text><text x="36" y="240" fill="#63C69A" font-size="13.5" font-weight="700" text-anchor="start">❯</text><rect x="52.2" y="228.5" width="8.1" height="13.5" fill="#7C5CD0" class="cursor" /><g clip-path="url(#panelClip)"><rect x="34" y="58.5" width="66.8" height="24" fill="#151022" class="t0" /><rect x="34" y="82.5" width="431.3" height="24" fill="#151022" class="t1" /><rect x="34" y="106.5" width="107.3" height="24" fill="#151022" class="t2" /><rect x="34" y="130.5" width="164" height="24" fill="#151022" class="t3" /><rect x="34" y="154.5" width="131.6" height="24" fill="#151022" class="t4" /><rect x="34" y="178.5" width="188.3" height="24" fill="#151022" class="t5" /><rect x="34" y="202.5" width="253.1" height="24" fill="#151022" class="t6" /></g></svg>"`;

